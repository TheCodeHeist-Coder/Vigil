# Copy to .env. Never commit .env.

# Required for verdicts, embeddings and the incident agent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional. Meko keeps agent memory, conversations and decision traces.
# Create a key at https://cloud.mekodata.ai under Settings > API Keys.
# Leave it empty and agent memory stays in YugabyteDB.
MEKO_API_KEY=
MEKO_MCP_URL=https://mcp.mekodata.ai/mcp
MEKO_DATAPACK_NAME=vigil-bench

KAFKA_BOOTSTRAP=localhost:9092
DATABASE_URL=postgresql://yugabyte@localhost:5433/vigil
BENCH_ID=bench-1

# Set to the demo laptop's LAN address so teammates can reach Kafka.
LAN_IP=localhost

# Set to 1 only as a stage fallback. Verdicts then come from saved runs.
REPLAY=0
